# Configuração do Jitsi self-hosted do MediLink (dev). Copie para .env com ./dev.sh init
# (isso também gera os segredos). Nunca versionar o .env.

# --- Básico ---
CONFIG=./.jitsi-cfg
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=America/Sao_Paulo
PUBLIC_URL=https://localhost:8443
# Em dev, o JVB anuncia o loopback. Em rede/LAN ou produção, troque pelo IP alcançável pelos clientes.
JVB_ADVERTISE_IPS=127.0.0.1
# Fixar a versão (a última estável no momento da escrita). Em produção, nunca usar "latest"/"unstable".
JITSI_IMAGE_VERSION=stable-11248-2

# --- T02: só entra quem porta JWT válido ---
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt
# O backend (medilink.jitsi.*) precisa usar os mesmos valores.
JWT_APP_ID=medilink
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=medilink
JWT_ACCEPTED_AUDIENCES=jitsi
XMPP_DOMAIN=meet.jitsi

# --- T07: traduz as claims do JWT (moderator/affiliation) em papéis na sala ---
# Sem este módulo ninguém é moderador por token: o médico entraria como participante comum.
XMPP_MUC_MODULES=token_affiliation,medilink_transcription

# --- T08: sala de espera. O host (moderador) admite o paciente ---
ENABLE_LOBBY=1

# --- Segredos internos (gerados por ./dev.sh init) ---
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=

# --- Não expor o Jitsi Meet padrão: só acessível pelos links/iframe do MediLink ---
# Sem página inicial (a interface fica só atrás do iframe; ver nginx-custom/).
ENABLE_WELCOME_PAGE=0
# A porta HTTP só redireciona para HTTPS.
ENABLE_HTTP_REDIRECT=1
# Quem pode embutir a interface: o próprio Jitsi e a origem do frontend MediLink. Em produção, o domínio real.
CSP_HEADER="frame-ancestors 'self' http://localhost:4200"

# --- Recursos da sala desabilitados (ver custom-config.js; estas variáveis reforçam do lado do servidor) ---
DISABLE_POLLS=1
ENABLE_BREAKOUT_ROOMS=0

# --- Mídia sempre pelo JVB (T11) ---
# Sem P2P: em sala de 2 pessoas o Jitsi passaria a mídia direto entre os navegadores, sem tocar o JVB, e o
# audio sink (captura no servidor) não receberia nada. Ver docs/plan.md, "Decisão: E2EE desligada".
ENABLE_P2P=0

# --- Audio sink (T11): para onde o JVB exporta o áudio de cada reunião ---
# URL do WebSocket do backend vista de DENTRO do container (podman: host.containers.internal; docker no Linux:
# host.docker.internal com extra_hosts). {{MEETING_ID}} é trocado pelo Jicofo. Sem espaços.
SINK_WS_URL=ws://host.containers.internal:8090/api/audio-sink/{{MEETING_ID}}
# Segredo compartilhado com o backend (MEDILINK_SINK_TOKEN). Gerado por ./dev.sh init.
SINK_TOKEN=
