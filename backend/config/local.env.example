# Copie para config/local.env (ignorado pelo git) e preencha a senha.
export MEDILINK_DB_URL='jdbc:sqlserver://localhost:1433;databaseName=medilink_dev;encrypt=true;trustServerCertificate=true'
export MEDILINK_TEST_DB_URL='jdbc:sqlserver://localhost:1433;databaseName=medilink_test;encrypt=true;trustServerCertificate=true'
export MEDILINK_DB_USER='sa'
export MEDILINK_DB_PASSWORD=''

# Chave mestra de 32 bytes (Base64) da cifra em repouso (T14). Gere com: openssl rand -base64 32
# Perder esta chave torna ilegíveis as transcrições gravadas; guarde-a em cofre fora do banco.
export MEDILINK_DATA_KEY=''
